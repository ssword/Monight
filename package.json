{
  "name": "monight",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Monight (墨页) - A modern PDF reader built with Tauri",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "icons:generate": "node scripts/generate-icons.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:embedpdf-offline": "node scripts/verify-embedpdf-offline.mjs"
  },
  "dependencies": {
    "@embedpdf/snippet": "2.15.0",
    "@tauri-apps/api": "~2.11.0",
    "@tauri-apps/plugin-store": "~2.4.0",
    "nouislider": "^15.8.1",
    "pdfjs-dist": "^5.4.530"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@tauri-apps/cli": "~2.11.0",
    "@types/nouislider": "^9.0.10",
    "happy-dom": "~20.12.0",
    "playwright": "1.60.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "~4.1.9"
  }
}
